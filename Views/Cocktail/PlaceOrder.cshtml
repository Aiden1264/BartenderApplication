@model BartenderApplication.Models.CocktailOrder

<div class="container mt-4">
    <h2 class="mb-4 text-center">Place a Cocktail Order</h2>

    <div class="card shadow-sm p-4">
        <form asp-action="PlaceOrder" method="post">
            <div class="mb-3">
                <label class="form-label">Patron Name</label>
                <input asp-for="PatronName" class="form-control" placeholder="Enter your name" />
            </div>

            <div class="mb-3">
                <label class="form-label">Cocktail Name</label>
                <select asp-for="CocktailName" asp-items="ViewBag.Cocktails" class="form-select">
                    <option value="">Select a cocktail...</option>
                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Notes (optional)</label>
                <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Any special instructions?"></textarea>
            </div>

            <button type="submit" class="btn btn-primary w-100">Submit Order</button>
        </form>
    </div>
</div>


